{
  "name": "varbase_bootstrap_paragraphs",
  "description": "Varbase Bootstrap Paragraphs",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "packageManager": "yarn@4.9.3",
  "main": "gulpfile.js",
  "scripts": {
    "theme:init": "gulp",
    "theme:build": "gulp compile",
    "theme:watch": "gulp watch",
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --config=.eslintrc.json --ext .yml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js --config=.eslintrc.json --ext .js .",
    "lint:css": "npx stylelint --config=.stylelintrc.json '**/*.css' --ignore-pattern 'includes/**' --ignore-pattern '**/includes/**'",
    "spellcheck": "cspell lint ."
  },
  "keywords": [
    "SASS",
    "Bootstrap",
    "Drupal",
    "Varbase",
    "Varbase Bootstrap Paragraphs",
    "Bootstrap Paragraphs",
    "Paragraphs"
  ],
  "author": "Vardot",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "bootstrap": "~4",
    "browser-sync": "^3.0.3",
    "cspell": "^8.16.1",
